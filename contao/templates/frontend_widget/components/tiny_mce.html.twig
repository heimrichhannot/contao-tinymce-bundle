<script>window.tinymce || document.write('<script src="{{ asset('js/tinymce.min.js', 'contao-components/tinymce4') }}">\x3C/script>')</script>

<script>
    window.tinymce && tinymce.init({
        selector: '#{{ selector }}',
        language: '{{ language }}',
        element_format: 'html',
        document_base_url: '{{ base }}',
        branding: false,
        promotion: false,

        {% block plugins %}
        plugins: 'link, lists',
        {% endblock %}

        {% block menubar %}
        menubar: '',
        {% endblock %}

        {% block toolbar %}
        toolbar: 'bold italic | bullist numlist',
        {% endblock %}

        {% block custom %}
        statusbar: false,
        min_height: 120,
        text_patterns: false,
        paste_as_text: true,
        {% endblock %}
    });
</script>