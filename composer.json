{
    "name": "heimrichhannot/contao-tinymce-bundle",
    "type": "contao-bundle",
    "description": "This bundle allow using tinymce in the contao frontend (form generator).",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "HeimrichHannot\\TinyMceBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "HeimrichHannot\\TinyMceBundle\\ContaoManager\\Plugin"
    },
    "require-dev": {
        "rector/rector": "^2.3",
        "contao/contao-rector": "dev-main",
        "symplify/easy-coding-standard": "^13.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "contao/manager-plugin": "^2.13"
    }
}
